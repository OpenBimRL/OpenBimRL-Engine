# Test fixtures resolved via IfcTestHelper (cwd / TEST_SRCDIR / OPENBIMRL_ENGINE_ROOT).
TEST_FIXTURES = glob(
    [
        "src/test/resources/**",
    ],
    exclude = [
        "src/test/resources/.gitignore",
    ],
)

kt_jvm_library(
    name = "engine_tests_lib",
    testonly = True,
    srcs = glob(
        [
            "src/test/**/*.kt",
            "src/test/**/*.java",
        ],
        allow_empty = True,
    ),
    deps = [
        ":engine_lib",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
        "@maven//:org_junit_jupiter_junit_jupiter_engine",
        "@maven//:org_junit_jupiter_junit_jupiter_params",
        "@maven//:org_junit_platform_junit_platform_launcher",
    ],
)

