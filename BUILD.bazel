load("@rules_java//java:defs.bzl", "java_binary", "java_test")
load("@rules_jvm_external//:kt_defs.bzl", "kt_jvm_export")
load("@rules_kotlin//kotlin:core.bzl", "define_kt_toolchain")
load("@rules_kotlin//kotlin:jvm.bzl", "kt_jvm_binary", "kt_jvm_library")

package(default_visibility = ["//visibility:public"])

define_kt_toolchain(
    name = "kotlin_toolchain",
    api_version = "2.1",
    jvm_target = "17",
    language_version = "2.1",
)

# ---------------------------------------------------------------------------
# Native (JNA C ABI) — from @openbimrl_native → libOpenBimRL-Engine-Native-x86_64.so
# ---------------------------------------------------------------------------

alias(
    name = "openbimrl_native",
    actual = "@openbimrl_native//:openbimrl_native",
)

# JNA classpath resource (see FunctionsNative.NATIVE_LIBRARY_RESOURCE).
# Stable arch-qualified name (no version): Maven GAV carries engine version.
genrule(
    name = "native_lib_so",
    srcs = ["@openbimrl_native//:openbimrl_native"],
    outs = ["libOpenBimRL-Engine-Native-x86_64.so"],
    cmd = """
set -euo pipefail
src=$$(echo "$(locations @openbimrl_native//:openbimrl_native)" | tr ' ' '\\n' | grep -E 'libOpenBIMRL_Native\\.so$$' | head -1)
if [[ -z "$${src}" || ! -f "$${src}" ]]; then
  echo "ERROR: libOpenBIMRL_Native.so not found in: $(locations @openbimrl_native//:openbimrl_native)" >&2
  exit 1
fi
cp -f "$${src}" "$@"
""",
    tags = [
        "no-remote",
    ],
)

# ---------------------------------------------------------------------------
# JVM / Kotlin library (JNA — FunctionsNative + native .so resource)
# ---------------------------------------------------------------------------

kt_jvm_library(
    name = "engine_lib",
    srcs = glob(
        [
            "src/main/jvm/**/*.kt",
            "src/main/jvm/**/*.java",
        ],
    ),
    resources = [
        ":native_lib_so",
    ],
    deps = [
        "@bvh_src//:bvh",
        "@openbimrl_api_src//:openbimrl_api",
        "@maven//:com_github_ajalt_colormath_colormath_jvm",
        "@maven//:com_google_code_gson_gson",
        "@maven//:commons_io_commons_io",
        "@maven//:io_arrow_kt_arrow_core_jvm",
        "@maven//:io_github_offlinebrain_khexagon_jvm",
        "@maven//:java3d_j3d_core",
        "@maven//:javax_vecmath_vecmath",
        "@maven//:javax_xml_bind_activation",
        "@maven//:javax_xml_bind_jaxb_api",
        "@maven//:net_java_dev_jna_jna",
        "@maven//:org_codeberg_iljo_kmp_gltf_model_kmp_gltf_model_jvm",
        "@maven//:org_glassfish_jaxb_jaxb_runtime",
        "@maven//:org_jetbrains_kotlin_kotlin_stdlib",
        "@maven//:org_jetbrains_kotlinx_kotlinx_serialization_json_jvm",
        "@maven//:org_reflections_reflections",
    ],
)

kt_jvm_binary(
    name = "console",
    main_class = "de.rub.bi.inf.openbimrl.ConsoleApplicationKt",
    runtime_deps = [":engine_lib"],
)

# Fat jar for container runtime (`java -jar`); built as //:console_app_deploy.jar.
java_binary(
    name = "console_app",
    main_class = "de.rub.bi.inf.openbimrl.ConsoleApplicationKt",
    runtime_deps = [":engine_lib"],
)

# Alias used by docs / smoke checks
alias(
    name = "openbimrl_engine",
    actual = ":engine_lib",
)

# ---------------------------------------------------------------------------
# Maven artifact (GitHub Packages) — GAV for REST consumers
#
# Coordinates: inf.bi.rub.de:openbimrl-engine:$(OPENBIMRL_ENGINE_VERSION)
# Default version is set in .bazelrc; CI overrides with YYYY.MM.DD.
#
# Private deps (OpenBIMRL-API, BVH) are bundled into the published jar.
# Maven Central deps are listed in the generated POM.
# classpath resource libOpenBimRL-Engine-Native-x86_64.so (JNA) from :engine_lib.
#
# Build only (produces *-project.jar + *-pom.xml):
#   bazel build //:openbimrl_engine_maven --define OPENBIMRL_ENGINE_VERSION=YYYY.MM.DD
#
# Publish (rules_jvm_external 7.1+ MavenPublisher):
#   MAVEN_REPO=file:///tmp/m2 bazel run //:openbimrl_engine_maven.publish
#   MAVEN_REPO=https://maven.pkg.github.com/OpenBimRL/OpenBimRL-Engine \
#     MAVEN_USER=… MAVEN_PASSWORD=… \
#     bazel run //:openbimrl_engine_maven.publish
# ---------------------------------------------------------------------------

kt_jvm_export(
    name = "openbimrl_engine_maven",
    maven_coordinates = "inf.bi.rub.de:openbimrl-engine:$(OPENBIMRL_ENGINE_VERSION)",
    tags = [
        "no-javadocs",
        "no-remote",
    ],
    runtime_deps = [":engine_lib"],
)

# ---------------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------------

# Test fixtures resolved via IfcTestHelper (cwd / TEST_SRCDIR / OPENBIMRL_ENGINE_ROOT).
TEST_FIXTURES = glob(
    [
        "src/test/resources/**",
    ],
    exclude = [
        "src/test/resources/.gitignore",
    ],
)

kt_jvm_library(
    name = "engine_tests_lib",
    testonly = True,
    srcs = glob(
        [
            "src/test/**/*.kt",
            "src/test/**/*.java",
        ],
        allow_empty = True,
    ),
    deps = [
        ":engine_lib",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
        "@maven//:org_junit_jupiter_junit_jupiter_engine",
        "@maven//:org_junit_jupiter_junit_jupiter_params",
        "@maven//:org_junit_platform_junit_platform_launcher",
    ],
)

java_test(
    name = "engine_tests",
    size = "large",
    args = [
        "--disable-banner",
        "--details=tree",
        "--select-class=de.rub.bi.inf.openbimrl.PrecalculationGraphOrderTest",
        "--select-class=de.rub.bi.inf.openbimrl.parallel.ParallelChecksOpenBimRLTest",
        "--select-class=de.rub.bi.inf.openbimrl.pathfinding.ShowDistancesOpenBimRLTest",
        "--select-class=de.rub.bi.inf.openbimrl.pathfinding.PathfindingMinimalIfcTest",
        "--select-class=de.rub.bi.inf.openbimrl.visualization.GltfVisualComposerTest",
        "--select-class=de.rub.bi.inf.openbimrl.functions.annotations.FunctionPortDiscoveryTest",
        "--select-class=de.rub.bi.inf.openbimrl.functions.math.MaximumTest",
        "--select-class=de.rub.bi.inf.openbimrl.functions.math.BinaryNumericFunctionsTest",
        "--select-class=de.rub.bi.inf.openbimrl.utils.pathfinding.PathFindingMovementCostTest",
        "--select-class=de.rub.bi.inf.openbimrl.utils.ifc.ElementApproximationServiceTest",
        "--select-class=de.rub.bi.inf.openbimrl.utils.math.DistanceTest",
    ],
    data = TEST_FIXTURES,
    jvm_flags = [
        "-Djava.awt.headless=true",
    ],
    main_class = "org.junit.platform.console.ConsoleLauncher",
    tags = [
        "native",
    ],
    use_testrunner = False,
    runtime_deps = [
        ":engine_tests_lib",
        "@maven//:org_junit_platform_junit_platform_console",
    ],
)

# Pure JVM smoke subset (no IFC / native required) — faster feedback.
java_test(
    name = "engine_unit_tests",
    size = "small",
    args = [
        "--disable-banner",
        "--details=tree",
        "--select-class=de.rub.bi.inf.openbimrl.utils.math.DistanceTest",
        "--select-class=de.rub.bi.inf.openbimrl.functions.math.BinaryNumericFunctionsTest",
        "--select-class=de.rub.bi.inf.openbimrl.functions.math.MaximumTest",
        "--select-class=de.rub.bi.inf.openbimrl.functions.annotations.FunctionPortDiscoveryTest",
        "--select-class=de.rub.bi.inf.openbimrl.visualization.GltfVisualComposerTest",
    ],
    jvm_flags = [
        "-Djava.awt.headless=true",
    ],
    main_class = "org.junit.platform.console.ConsoleLauncher",
    use_testrunner = False,
    runtime_deps = [
        ":engine_tests_lib",
        "@maven//:org_junit_platform_junit_platform_console",
    ],
)

# Helpful no-op target for docs smoke (`bazel build //:help`)
filegroup(
    name = "help",
    srcs = [
        "BUILD.md",
        "MODULE.bazel",
    ],
)
