package(default_visibility = ["//visibility:public"])

define_kt_toolchain(
    name = "kotlin_toolchain",
    api_version = "2.1",
    jvm_target = "17",
    language_version = "2.1",
)

# ---------------------------------------------------------------------------
# Native (JNI) — from @openbimrl_native → libopenbimrl_jni.so
# ---------------------------------------------------------------------------

alias(
    name = "openbimrl_native",
    actual = "@openbimrl_native//:openbimrl_native",
)

# Baked into EngineInfo.version (see openbimrl_engine_version.properties).
genrule(
    name = "engine_version_properties",
    outs = ["openbimrl_engine_version.properties"],
    cmd = """
set -euo pipefail
version="$(OPENBIMRL_ENGINE_VERSION)"
if [[ -z "$${version}" ]]; then
  version="dev"
fi
printf 'version=%s\\n' "$${version}" > '$@'
""",
)

# JNI classpath resource (see NativeEngine.NATIVE_LIBRARY_RESOURCE).
genrule(
    name = "native_lib_so",
    srcs = ["@openbimrl_native//:openbimrl_native"],
    outs = ["libopenbimrl_jni.so"],
    cmd = """
set -euo pipefail
src=$$(echo "$(locations @openbimrl_native//:openbimrl_native)" | tr ' ' '\\n' | grep -E 'libopenbimrl_jni\\.so$$' | head -1)
if [[ -z "$${src}" || ! -f "$${src}" ]]; then
  echo "ERROR: libopenbimrl_jni.so not found in: $(locations @openbimrl_native//:openbimrl_native)" >&2
  exit 1
fi
cp -f "$${src}" "$@"
""",
    tags = [
        "no-remote",
    ],
)

# ---------------------------------------------------------------------------
# JVM / Kotlin library (JNI — NativeEngine + native .so resource)
# ---------------------------------------------------------------------------

ENGINE_JVM_SRCS = glob(
    [
        "src/main/jvm/**/*.kt",
        "src/main/jvm/**/*.java",
    ],
)

ENGINE_JVM_DEPS = [
    "@bvh_src//:bvh",
    "@openbimrl_api_src//:openbimrl_api",
    "@maven//:com_github_ajalt_colormath_colormath_jvm",
    "@maven//:commons_io_commons_io",
    "@maven//:io_arrow_kt_arrow_core_jvm",
    "@maven//:io_github_offlinebrain_khexagon_jvm",
    "@maven//:java3d_j3d_core",
    "@maven//:javax_vecmath_vecmath",
    "@maven//:javax_xml_bind_jaxb_api",
    "@maven//:javax_xml_bind_activation",
    "@maven//:org_codeberg_iljo_kmp_gltf_model_kmp_gltf_model_jvm",
    "@maven//:org_glassfish_jaxb_jaxb_runtime",
    "@maven//:org_jetbrains_kotlin_kotlin_stdlib",
    "@maven//:org_jetbrains_kotlinx_kotlinx_serialization_json_jvm",
    "@maven//:org_reflections_reflections",
]

# JVM-only (no embedded .so). ROCm docker image compiles native at container start.
kt_jvm_library(
    name = "engine_lib_jvm",
    srcs = ENGINE_JVM_SRCS,
    resources = [
        ":engine_version_properties",
    ],
    deps = ENGINE_JVM_DEPS,
)

kt_jvm_library(
    name = "engine_lib",
    srcs = ENGINE_JVM_SRCS,
    resources = [
        ":engine_version_properties",
        ":native_lib_so",
    ],
    deps = ENGINE_JVM_DEPS,
)

kt_jvm_binary(
    name = "console",
    main_class = "de.rub.bi.inf.openbimrl.ConsoleApplicationKt",
    runtime_deps = [":engine_lib"],
)

# Fat jar for container runtime (`java -jar`); built as //:console_app_deploy.jar.
java_binary(
    name = "console_app",
    main_class = "de.rub.bi.inf.openbimrl.ConsoleApplicationKt",
    runtime_deps = [":engine_lib"],
)

# JVM-only fat jar (no native). ROCm image bundles .so at container start.
java_binary(
    name = "console_jvm_app",
    main_class = "de.rub.bi.inf.openbimrl.ConsoleApplicationKt",
    runtime_deps = [":engine_lib_jvm"],
)

# Alias used by docs / smoke checks
alias(
    name = "openbimrl_engine",
    actual = ":engine_lib",
)

# ---------------------------------------------------------------------------
# Maven artifact (GitHub Packages) — GAV for REST consumers
#
# Coordinates: de.rub.bi.inf.openbimrl.engine:core:$(OPENBIMRL_ENGINE_VERSION)
# Default version is set in .bazelrc; CI overrides with YYYY.MM.DD.
#
# Private deps (OpenBIMRL schema / BVH) are bundled into the published jar.
# Maven Central deps are listed in the generated POM.
# classpath resource libopenbimrl_jni.so from :engine_lib.
#
# Build only (produces *-project.jar + *-pom.xml):
#   bazel build //:openbimrl_engine_maven --define OPENBIMRL_ENGINE_VERSION=YYYY.MM.DD
#
# Publish (rules_jvm_external 7.1+ MavenPublisher):
#   MAVEN_REPO=file:///tmp/m2 bazel run //:openbimrl_engine_maven.publish
#   MAVEN_REPO=https://maven.pkg.github.com/OpenBimRL/OpenBimRL-Engine \
#     MAVEN_USER=… MAVEN_PASSWORD=… \
#     bazel run //:openbimrl_engine_maven.publish
# ---------------------------------------------------------------------------

kt_jvm_export(
    name = "openbimrl_engine_maven",
    maven_coordinates = "de.rub.bi.inf.openbimrl.engine:core:$(OPENBIMRL_ENGINE_VERSION)",
    tags = [
        "no-javadocs",
        "no-remote",
    ],
    runtime_deps = [":engine_lib"],
)

